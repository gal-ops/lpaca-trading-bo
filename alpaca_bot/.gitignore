.env
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# The production DB/report ARE committed (like the old bot's
# trades.xlsx/bot_state.json) so state persists across CI runs -- only
# transient journal/sidecar files are ignored.
data/state/*.db-journal
data/state/*.db-wal
data/state/*.db-shm
data/models/*.pkl
data/models/*.joblib
STOP
.venv/

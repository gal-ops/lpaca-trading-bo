# Copy to .env and fill in. .env is gitignored -- never commit real values.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Must be the literal string "true" -- anything else refuses to start.
PAPER_TRADING=true

# Paper endpoint only. The system refuses to start if this is not an
# Alpaca paper-trading host, regardless of PAPER_TRADING.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# SQLite file (source of truth for everything the bot persists).
DATABASE_PATH=data/state/alpaca_bot.db

# Optional: path to a config override (defaults to config/default.yaml
# merged with config/paper.yaml).
ALPACA_BOT_CONFIG=config/paper.yaml
